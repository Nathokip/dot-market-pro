generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  portfolios Portfolio[]
}

model Portfolio {
  id        String   @id @default(uuid())
  userId    String
  symbol    String
  quantity  Float
  price     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}